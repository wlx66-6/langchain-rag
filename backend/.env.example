# ============================================================
# 复制本文件为 backend/.env 后按需修改。
# backend/.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。
# ============================================================

# ---- 阿里云百炼 / 通义千问（必填：否则无法回答）----
# 注册 https://bailian.console.aliyun.com/ 并开通通义千问后获取
DASHSCOPE_API_KEY=在这里填入你的百炼API_KEY
# 使用的模型：qwen-plus / qwen-turbo / qwen-max
QWEN_MODEL=qwen-plus

# ---- 安全（必填：JWT 签名密钥，缺失则启动报错）----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=请替换为随机长字符串
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 管理员初始账号（首次启动建号用；不配 ADMIN_PASSWORD 则跳过建号）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- CORS：允许访问的前端来源，多个用逗号分隔 ----
CORS_ORIGINS=http://127.0.0.1:5173

# ---- 本地向量化模型与检索参数 ----
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# ---- 重排（rerank）参数 ----
RERANK_MODEL=gte-rerank-v2
RERANK_CANDIDATES=10
RERANK_TOP_N=3
RERANK_MIN_SCORE=0.2

# ---- 压力测试开关（日常保持 0；压测时才置 1，见 loadtest/README.md）----
MOCK_LLM=0

# ---- HuggingFace 下载镜像（国内下载 bge-m3 慢时启用；能直连可留空）----
HF_ENDPOINT=https://hf-mirror.com