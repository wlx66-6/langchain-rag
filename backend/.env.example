# ============================================================
# 复制本文件为 backend/.env 后按需修改。
# backend/.env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。
# ============================================================

# ---- 阿里云百炼 / 通义千问（必填：否则无法回答）----
# 注册 https://bailian.console.aliyun.com/ 并开通通义千问后获取
DASHSCOPE_API_KEY=在这里填入你的百炼API_KEY
# 使用的模型：qwen-plus / qwen-turbo / qwen-max
QWEN_MODEL=qwen-plus

# ---- 安全（必填：JWT 签名密钥，缺失则启动报错）----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=请替换为随机长字符串
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 管理员初始账号（首次启动建号用；不配 ADMIN_PASSWORD 则跳过建号）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- CORS：允许访问的前端来源，多个用逗号分隔 ----
CORS_ORIGINS=http://127.0.0.1:5173

# ---- 本地向量化模型与检索参数 ----
# 可填 HF 仓库名（首次自动下载），也可填本地目录的绝对路径（模型已手动下载时）。
# 若走不通 HuggingFace，用魔搭下载后把这里改成该目录，见 README「常见问题」。
EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# ---- 重排（rerank）参数 ----
RERANK_MODEL=gte-rerank-v2
RERANK_CANDIDATES=10
RERANK_TOP_N=3
RERANK_MIN_SCORE=0.2

# ---- 上传限制 ----
# 单个上传文件的大小上限（字节）。默认 20971520 = 20MB；超限接口返回 413。
MAX_UPLOAD_SIZE=20971520

# ---- 压力测试开关（日常保持 0；压测时才置 1，见 loadtest/README.md）----
# 置 1 时问答改用假大模型并跳过远程重排，仅供本地压测，生产务必保持 0。
MOCK_LLM=0

# ---- HuggingFace 下载镜像（首次下载 bge-m3 时生效；能直连可留空）----
# 实测该镜像在部分网络下会连接超时。若下载失败，改用 ModelScope（魔搭）：
#   python -c "from modelscope import snapshot_download; print(snapshot_download('BAAI/bge-m3'))"
# 然后把上面的 EMBEDDING_MODEL 改成打印出的本地目录即可（无需本项）。
HF_ENDPOINT=https://hf-mirror.com

# ---- 存储路径（一般无需修改；留空则用 backend/data/ 下的默认值）----
# DATA_DIR=backend/data
# CHROMA_DIR=backend/data/chroma
# UPLOAD_DIR=backend/data/uploads
# SQLITE_URL=sqlite:///backend/data/app.db